# Copie este arquivo para .env e preencha os valores reais.
# Nunca faça commit do arquivo .env (já está no .gitignore).

# String de conexão com o PostgreSQL.
# Desenvolvimento local:
#   postgresql://usuario:senha@localhost:5432/bemviver_db?schema=public
# Produção (Supabase, exemplo — use a "Connection string" em modo "Transaction"
# fornecida pelo painel do Supabase, com pgbouncer):
#   postgresql://postgres:[SENHA]@[HOST].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Segredo usado para assinar os cookies de sessão (JWT). NUNCA reutilize o
# valor de desenvolvimento em produção. Gere um novo com:
#   openssl rand -base64 32
SESSION_SECRET=""

NODE_ENV="production"

# Senha provisória do usuário administrador criado por `npm run db:seed`
# (achado SEG-1 da auditoria — a senha nunca deve ficar hardcoded no código).
# Se deixar em branco, o seed gera uma senha aleatória forte e a imprime uma
# única vez no terminal — copie-a dali. Usada também pelos scripts de smoke
# test (`npm run test:smoke*`), que fazem login com essa mesma senha.
SEED_ADMIN_PASSWORD=""

# Envio de e-mail (fluxo "esqueci minha senha") via SMTP do Gmail, usando a
# conta que a Bem Viver já usa. GMAIL_APP_PASSWORD NÃO é a senha normal da
# conta Google — é uma "senha de app" de 16 caracteres gerada em
# myaccount.google.com/apppasswords (exige verificação em duas etapas ativada
# na conta). Sem essas duas variáveis, o link de recuperação só é impresso no
# log do servidor (não é enviado por e-mail de verdade).
GMAIL_USER="bemviverassessoria.cond@gmail.com"
GMAIL_APP_PASSWORD=""

# URL pública do sistema, usada para montar o link dentro do e-mail de
# recuperação de senha. Em produção na Railway isso já é preenchido
# automaticamente (RAILWAY_PUBLIC_DOMAIN) — só defina APP_URL manualmente se
# precisar sobrescrever esse valor.
APP_URL=""
