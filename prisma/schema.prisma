// ============================================================================
// BEM VIVER — Sistema de Gestão Condominial
// Schema do banco de dados (PostgreSQL via Prisma ORM)
//
// Convenções:
//  - Todos os valores monetários usam Decimal(12,2) — nunca Float, para evitar
//    erros de arredondamento em cálculos financeiros.
//  - Exclusões de registros financeiros/cadastrais são lógicas (soft delete via
//    campo `excluidoEm`), nunca físicas — proteção contra exclusão acidental
//    exigida pela missão do projeto.
//  - `criadoEm`/`atualizadoEm` em todas as tabelas relevantes para auditoria.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// IDENTIDADE & ACESSO
// ----------------------------------------------------------------------------

enum PapelUsuario {
  ADMIN
  GESTOR
  OPERACIONAL
}

model Usuario {
  id            String       @id @default(cuid())
  nome          String
  email         String       @unique
  senhaHash     String
  papel         PapelUsuario @default(OPERACIONAL)
  ativo         Boolean      @default(true)
  avatarUrl     String?
  telefone      String?
  ultimoLoginEm DateTime?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  lancamentosCriados             LancamentoFinanceiro[]  @relation("LancamentoCriadoPor")
  prestacoesPublicadas           PrestacaoContas[]       @relation("PrestacaoPublicadaPor")
  documentosEnviados             Documento[]             @relation("DocumentoEnviadoPor")
  movimentosFundoReservaCriados  MovimentoFundoReserva[] @relation("FundoReservaCriadoPor")
  logsAuditoria                  LogAuditoria[]
  tokensRecuperacao              TokenRecuperacaoSenha[]

  @@map("usuarios")
}

model TokenRecuperacaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@map("tokens_recuperacao_senha")
}

// ----------------------------------------------------------------------------
// CADASTROS ESTRUTURAIS
// ----------------------------------------------------------------------------

enum StatusCondominio {
  ATIVO
  INATIVO
  PROSPECT
}

enum TipoSindico {
  PROFISSIONAL
  MORADOR
}

model Sindico {
  id       String      @id @default(cuid())
  nome     String
  cpf      String?     @unique
  email    String?
  telefone String?
  tipo     TipoSindico @default(PROFISSIONAL)
  ativo    Boolean     @default(true)
  criadoEm DateTime    @default(now())

  condominios Condominio[]

  @@map("sindicos")
}

model Condominio {
  id                 String           @id @default(cuid())
  nome               String
  // Razão social (nome empresarial oficial do condomínio, ex: "Condomínio
  // Edifício X"), separada de `nome` (nome fantasia/apelido usado no
  // dia a dia — ex: "Residencial Barcelia"). Opcional porque nem todo
  // condomínio já tem esse dado cadastrado; nunca inventar — só preencher
  // quando fornecido pela Bem Viver.
  razaoSocial        String?
  cnpj               String?          @unique
  endereco           String?
  cidade             String?
  estado             String?          @db.VarChar(2)
  cep                String?
  banco              String?
  agencia            String?
  conta              String?
  qtdUnidades        Int?
  valorHonorarios    Decimal?         @db.Decimal(12, 2)
  diaVencimentoTaxa  Int?
  dataInicioContrato DateTime?
  dataFimContrato    DateTime?
  status             StatusCondominio @default(ATIVO)
  sindicoId          String?
  sindico            Sindico?         @relation(fields: [sindicoId], references: [id])
  observacoes        String?
  excluidoEm         DateTime?
  criadoEm           DateTime         @default(now())
  atualizadoEm       DateTime         @updatedAt

  unidades         Unidade[]
  lancamentos      LancamentoFinanceiro[]
  titulos          TituloFinanceiro[]
  prestacoesContas PrestacaoContas[]
  fundoReserva     MovimentoFundoReserva[]
  documentos       Documento[]
  contratos        Contrato[]
  assembleias      Assembleia[]
  representantes   RepresentanteCondominio[]
  contatos         ContatoCondominio[]
  garantidoras     CondominioGarantidora[]

  @@map("condominios")
}

enum PapelRepresentanteCondominio {
  SUBSINDICO
  CONSELHEIRO
  CONSELHEIRO_PRESIDENTE
  // Histórico de síndico (Fase 1 do Sistema de Gestão — Relatório de
  // Descoberta, set/2026). `Condominio.sindicoId`/`Sindico` continuam sendo
  // o ponteiro "atual" (conveniente para exibição rápida e para reaproveitar
  // um mesmo síndico profissional em vários condomínios), mas não guardavam
  // histórico: trocar o síndico perdia silenciosamente quem ocupou o cargo
  // antes. A auditoria do Drive dos 5 condomínios (set/2026) encontrou 3
  // casos reais de troca de síndico em menos de 2 anos — inclusive um caso
  // em que um documento formal foi assinado pelo síndico já renunciante,
  // um risco jurídico real que só é detectável com histórico de mandato.
  // Toda troca de `Condominio.sindicoId` agora também encerra o registro
  // SINDICO ativo (dataFim=hoje, ativo=false) e cria um novo — mesmo padrão
  // já validado aqui para subsíndico/conselho e em `Morador`.
  SINDICO
}

// Subsíndico, conselho e histórico de síndico do condomínio.
// Segue o mesmo padrão de histórico já validado em `Morador` (Sprint 6):
// `ativo` + `dataInicio`/`dataFim` respondem "quem ocupava este papel em
// determinada data" sem apagar histórico ao trocar de gestão. O síndico
// titular *atual* continua modelado por `Sindico`/`Condominio.sindicoId`
// (já existente, mantido por conveniência/reaproveitamento entre
// condomínios); este modelo cobre os papéis que a Bem Viver ainda não tinha
// estrutura própria para registrar (Fase 1 do PLANO-EVOLUCAO-V2.md) e,
// desde set/2026, também o histórico de mandatos de síndico (papel
// SINDICO) — ver `salvarCondominio`.
model RepresentanteCondominio {
  id           String                       @id @default(cuid())
  condominioId String
  condominio   Condominio                   @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  papel        PapelRepresentanteCondominio
  nome         String
  cpf          String?
  email        String?
  telefone     String?
  ativo        Boolean                      @default(true)
  dataInicio   DateTime                     @default(now())
  dataFim      DateTime?
  observacoes  String?
  criadoEm     DateTime                     @default(now())
  atualizadoEm DateTime                     @updatedAt

  @@index([condominioId, papel, ativo])
  @@map("representantes_condominio")
}

// Contatos operacionais do condomínio (portaria, zelador, financeiro do
// condomínio, administradora anterior, etc.). `tipo` é texto livre e não
// enum: os papéis variam muito de condomínio para condomínio e fechar
// essa lista agora seria prematuro sem volume real de dados (mesmo
// racional que já levou `CategoriaFinanceira` a ser uma tabela
// configurável em vez de enum — ver seção 1.5 do PLANO-EVOLUCAO-V2.md).
model ContatoCondominio {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  tipo         String
  nome         String?
  email        String?
  telefone     String?
  observacoes  String?
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  @@index([condominioId, ativo])
  @@map("contatos_condominio")
}

// Empresa terceirizada de garantia/cobrança (ex.: "Confiança Condomínio
// Garantido", "LLZ Solução Cobrança") — Fase 1 do Sistema de Gestão
// (Relatório de Descoberta, set/2026). Achado da auditoria do Drive dos 5
// condomínios: em pelo menos 4 dos 5, a garantidora é uma peça financeira
// central (recebe os boletos, retém uma taxa e repassa o líquido ao
// condomínio), mas não existia como conceito no sistema — cada prestação
// de contas só citava o nome em texto livre na descrição do lançamento.
// Cadastro simples e reutilizável entre condomínios, no mesmo padrão de
// `Sindico`/`Fornecedor` (não um detalhe por condomínio como
// `ContatoCondominio`).
model Garantidora {
  id           String   @id @default(cuid())
  nome         String   @unique
  cnpj         String?  @unique
  // Percentual padrão de taxa retida (ex.: 12.51 = 12,51%). Cada vínculo
  // com um condomínio pode registrar uma taxa diferente da padrão em
  // `CondominioGarantidora.taxaAplicada` (observado na prática: taxas
  // variam de ~7,5% a ~15% entre os condomínios auditados).
  taxaPadrao   Decimal? @db.Decimal(5, 2)
  telefone     String?
  email        String?
  ativo        Boolean  @default(true)
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  vinculos CondominioGarantidora[]

  @@map("garantidoras")
}

// Vínculo historizado condomínio↔garantidora — mesmo padrão de
// `RepresentanteCondominio`/`Morador`: `ativo`+`dataInicio`/`dataFim`
// respondem "qual garantidora atendia este condomínio em determinada
// data", sem apagar histórico ao trocar de prestador. A auditoria do Drive
// confirmou pelo menos 2 trocas reais de garantidora (Montreal e Murilo II,
// ambas de "LLZ" para "Confiança" no 2º semestre de 2025) — sem histórico,
// relatórios antigos referenciando a garantidora anterior perdem contexto.
// A consistência de (ativo, dataFim) — e a garantia de no máximo um vínculo
// ativo por condomínio — é mantida pela Server Action (`vincularGarantidora`
// encerra o vínculo ativo anterior dentro da mesma transação), não por uma
// constraint de banco, mesmo racional já usado nos modelos irmãos acima.
model CondominioGarantidora {
  id            String      @id @default(cuid())
  condominioId  String
  condominio    Condominio  @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  garantidoraId String
  garantidora   Garantidora @relation(fields: [garantidoraId], references: [id])
  taxaAplicada  Decimal?    @db.Decimal(5, 2)
  ativo         Boolean     @default(true)
  dataInicio    DateTime    @default(now())
  dataFim       DateTime?
  observacoes   String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  @@index([condominioId, ativo])
  @@index([garantidoraId])
  @@map("condominio_garantidoras")
}

enum StatusUnidade {
  OCUPADA
  VAGA
  EM_OBRAS
}

model Unidade {
  id            String        @id @default(cuid())
  condominioId  String
  condominio    Condominio    @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  identificacao String
  bloco         String?
  fracaoIdeal   Decimal?      @db.Decimal(8, 5)
  valorTaxaBase Decimal?      @db.Decimal(12, 2)
  status        StatusUnidade @default(OCUPADA)
  observacoes   String?
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  moradores  Morador[]
  titulos    TituloFinanceiro[]
  documentos Documento[]

  @@unique([condominioId, identificacao])
  @@map("unidades")
}

enum TipoVinculoMorador {
  PROPRIETARIO
  INQUILINO
  DEPENDENTE
}

// Histórico de vínculo pessoa-unidade (Sprint 6, setembro/2026 — Opção A da
// seção 5.2 de EVOLUCAO-PLATAFORMA.md). `dataInicio`/`dataFim` respondem
// "quem morava na unidade X em determinada data" sem precisar de uma
// entidade `Pessoa` separada (Opção B, avaliada e descartada por
// complexidade sem caso de uso real). O par (ativo, dataFim) é mantido
// consistente pela Server Action: inativar sempre grava `dataFim = hoje`,
// reativar sempre limpa `dataFim` — nunca editados soltos um sem o outro
// (ver `alternarAtivoMorador`). Para um morador que se muda e depois volta,
// o padrão correto é encerrar o registro atual e cadastrar um novo (não
// reativar o antigo), preservando o intervalo vago no histórico.
model Morador {
  id          String             @id @default(cuid())
  unidadeId   String
  unidade     Unidade            @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nome        String
  cpf         String?
  email       String?
  telefone    String?
  tipoVinculo TipoVinculoMorador @default(PROPRIETARIO)
  principal   Boolean            @default(false)
  ativo       Boolean            @default(true)
  dataInicio  DateTime           @default(now())
  dataFim     DateTime?
  criadoEm    DateTime           @default(now())

  @@index([unidadeId, ativo])
  @@map("moradores")
}

model Fornecedor {
  id           String   @id @default(cuid())
  nome         String
  cnpjCpf      String?
  categoria    String?
  telefone     String?
  email        String?
  endereco     String?
  ativo        Boolean  @default(true)
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentos LancamentoFinanceiro[]
  titulos     TituloFinanceiro[]
  contratos   Contrato[]
  documentos  Documento[]

  @@map("fornecedores")
}

// ----------------------------------------------------------------------------
// FINANCEIRO
// ----------------------------------------------------------------------------

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum NaturezaLancamento {
  FIXA
  EXTRA
  BANCARIA
  REPASSE
}

model CategoriaFinanceira {
  id            String             @id @default(cuid())
  nome          String
  tipo          TipoLancamento
  natureza      NaturezaLancamento @default(FIXA)
  cor           String?            @default("#C9A227")
  ordem         Int                @default(0)
  padraoSistema Boolean            @default(false)
  ativo         Boolean            @default(true)

  // Hierarquia de 1 nível só (categoria-mãe → subcategorias). Uma
  // subcategoria não pode por sua vez ter subcategorias — validado na
  // Server Action, não no banco, para manter o schema simples.
  categoriaPaiId String?
  categoriaPai   CategoriaFinanceira?  @relation("SubcategoriasFinanceiras", fields: [categoriaPaiId], references: [id], onDelete: SetNull)
  subcategorias  CategoriaFinanceira[] @relation("SubcategoriasFinanceiras")

  lancamentos LancamentoFinanceiro[]
  titulos     TituloFinanceiro[]

  @@unique([nome, tipo])
  @@index([categoriaPaiId])
  @@map("categorias_financeiras")
}

enum FormaPagamento {
  PIX
  BOLETO
  TED
  DOC
  DEBITO_AUTOMATICO
  DINHEIRO
  CARTAO
  OUTRO
}

model LancamentoFinanceiro {
  id             String              @id @default(cuid())
  condominioId   String
  condominio     Condominio          @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  categoriaId    String
  categoria      CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  fornecedorId   String?
  fornecedor     Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  tipo           TipoLancamento
  descricao      String
  valor          Decimal             @db.Decimal(12, 2)
  competenciaMes Int
  competenciaAno Int
  dataMovimento  DateTime
  formaPagamento FormaPagamento?
  comprovanteUrl String?
  observacoes    String?
  conciliado     Boolean             @default(false)
  criadoPorId    String
  criadoPor      Usuario             @relation("LancamentoCriadoPor", fields: [criadoPorId], references: [id])
  excluidoEm     DateTime?
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt

  itensPrestacao PrestacaoContasItem[]

  @@index([condominioId, competenciaAno, competenciaMes])
  @@map("lancamentos_financeiros")
}

enum StatusTitulo {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum TipoTitulo {
  PAGAR
  RECEBER
}

model TituloFinanceiro {
  id             String               @id @default(cuid())
  condominioId   String
  condominio     Condominio           @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  tipo           TipoTitulo
  descricao      String
  categoriaId    String?
  categoria      CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  fornecedorId   String?
  fornecedor     Fornecedor?          @relation(fields: [fornecedorId], references: [id])
  unidadeId      String?
  unidade        Unidade?             @relation(fields: [unidadeId], references: [id])
  valor          Decimal              @db.Decimal(12, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusTitulo         @default(PENDENTE)
  recorrente     Boolean              @default(false)
  observacoes    String?
  excluidoEm     DateTime?
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt

  @@index([condominioId, status, dataVencimento])
  @@map("titulos_financeiros")
}

// ----------------------------------------------------------------------------
// PRESTAÇÃO DE CONTAS — módulo principal
// ----------------------------------------------------------------------------

enum StatusPrestacaoContas {
  RASCUNHO
  EM_REVISAO
  PUBLICADA
}

model PrestacaoContas {
  id             String                @id @default(cuid())
  condominioId   String
  condominio     Condominio            @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  competenciaMes Int
  competenciaAno Int
  saldoAnterior  Decimal               @default(0) @db.Decimal(12, 2)
  totalReceitas  Decimal               @default(0) @db.Decimal(12, 2)
  totalDespesas  Decimal               @default(0) @db.Decimal(12, 2)
  saldoAtual     Decimal               @default(0) @db.Decimal(12, 2)
  status         StatusPrestacaoContas @default(RASCUNHO)
  pdfUrl         String?
  observacoes    String?
  publicadoPorId String?
  publicadoPor   Usuario?              @relation("PrestacaoPublicadaPor", fields: [publicadoPorId], references: [id])
  publicadoEm    DateTime?
  criadoEm       DateTime              @default(now())
  atualizadoEm   DateTime              @updatedAt

  itens PrestacaoContasItem[]

  @@unique([condominioId, competenciaMes, competenciaAno])
  @@map("prestacoes_contas")
}

model PrestacaoContasItem {
  id                String               @id @default(cuid())
  prestacaoContasId String
  prestacaoContas   PrestacaoContas      @relation(fields: [prestacaoContasId], references: [id], onDelete: Cascade)
  lancamentoId      String
  lancamento        LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id])
  valorConsiderado  Decimal              @db.Decimal(12, 2)

  @@unique([prestacaoContasId, lancamentoId])
  @@map("prestacoes_contas_itens")
}

// ----------------------------------------------------------------------------
// FUNDO DE RESERVA / APLICAÇÕES
// ----------------------------------------------------------------------------
// Exclusão é física (sem `excluidoEm`), gated pela ausência de qualquer
// estado de fluxo — mesmo padrão de PrestacaoContas (excluirPrestacaoContas):
// combinar soft-delete com a unique constraint (condominioId, mes, ano)
// impediria recriar um movimento do mesmo mês após excluir o anterior.

model MovimentoFundoReserva {
  id             String     @id @default(cuid())
  condominioId   String
  condominio     Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  competenciaMes Int
  competenciaAno Int
  saldoInicial   Decimal    @db.Decimal(12, 2)
  aportes        Decimal    @default(0) @db.Decimal(12, 2)
  resgates       Decimal    @default(0) @db.Decimal(12, 2)
  rendimento     Decimal    @default(0) @db.Decimal(12, 2)
  saldoFinal     Decimal    @db.Decimal(12, 2)
  observacoes    String?
  criadoPorId    String
  criadoPor      Usuario    @relation("FundoReservaCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt

  @@unique([condominioId, competenciaMes, competenciaAno])
  @@map("movimentos_fundo_reserva")
}

// ----------------------------------------------------------------------------
// DOCUMENTOS & CONTRATOS (estrutura pronta — Fase 2 traz upload/central completa)
// ----------------------------------------------------------------------------

// Categoria de documento — migrada de enum fixo para tabela configurável
// (Fase 1 do PLANO-EVOLUCAO-V2.md), no mesmo padrão já validado em
// `CategoriaFinanceira`: `padraoSistema` marca as 7 categorias herdadas do
// enum anterior (não podem ser desativadas, preservando compatibilidade
// com o histórico), `ordem` controla a posição nos seletores, `cor` permite
// diferenciação visual futura no explorador de documentos. Diferente de
// `ContatoCondominio.tipo` (texto livre): aqui vale a pena uma tabela de
// verdade porque a lista é compartilhada entre todos os condomínios e
// alimenta filtros/relatórios, não é um detalhe pontual por condomínio.
model CategoriaDocumento {
  id            String   @id @default(cuid())
  nome          String   @unique
  cor           String?  @default("#b3892f")
  ordem         Int      @default(0)
  padraoSistema Boolean  @default(false)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Hierarquia de 1 nível só, mesmo padrão introduzido em
  // CategoriaFinanceira na Fase 2 — ver o comentário lá para o racional
  // completo. Validado na Server Action, não no banco.
  categoriaPaiId String?
  categoriaPai   CategoriaDocumento?  @relation("SubcategoriasDocumento", fields: [categoriaPaiId], references: [id], onDelete: SetNull)
  subcategorias  CategoriaDocumento[] @relation("SubcategoriasDocumento")

  documentos Documento[]

  @@index([categoriaPaiId])
  @@map("categorias_documento")
}

// Central de Documentos (Sprint 4) — o modelo já existia desde a Fase 1
// ("estrutura pronta"), mas sem os campos necessários para um upload real
// (nome original do arquivo, tipo/mime, validade para alertas de vencimento)
// nem exclusão lógica. `arquivoUrl` passa a guardar a *chave* do objeto no
// bucket S3-compatível do Railway (não uma URL pública — o bucket é privado;
// o download é sempre mediado por uma rota autenticada que gera uma URL
// assinada de curta duração). Ver src/lib/storage.ts.
//
// Fase 3 do Plano de Evolução V2 (setembro/2026) ampliou os metadados:
// competência (mês/ano do documento, útil para comprovantes financeiros),
// vínculo opcional com fornecedor/unidade (documentos que dizem respeito a
// uma entidade específica, não só ao condomínio como um todo), tags (busca
// livre), hash SHA-256 do arquivo (preparo para deduplicação na Fase 4) e
// proveniência (como o documento entrou no sistema). Deliberadamente NÃO
// inclui vínculo com lançamento financeiro/prestação de contas (isso é
// escopo da Fase 5, "integração documentos ↔ financeiro") nem com morador
// (sem caso de uso concreto ainda) nem uma taxonomia extra de "tipo
// documental" (redundante com categoria+subcategoria sem um exemplo
// concreto do que distinguiria as duas coisas).
model Documento {
  id             String             @id @default(cuid())
  condominioId   String?
  condominio     Condominio?        @relation(fields: [condominioId], references: [id])
  nome           String
  descricao      String?
  categoriaId    String
  categoria      CategoriaDocumento @relation(fields: [categoriaId], references: [id])
  competenciaMes Int?
  competenciaAno Int?
  fornecedorId   String?
  fornecedor     Fornecedor?        @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  unidadeId      String?
  unidade        Unidade?           @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  tags           String[]           @default([])
  arquivoUrl     String
  arquivoNome    String?
  arquivoTipo    String?
  tamanhoBytes   Int?
  hashArquivo    String?
  // "UPLOAD_MANUAL" (padrão hoje) | "IMPORTACAO_EM_MASSA" (Fase 4, ainda não
  // implementada) — String livre, não enum, mesmo padrão já usado em
  // LancamentoFinanceiro.formaPagamento nesta base de código.
  proveniencia   String             @default("UPLOAD_MANUAL")
  dataValidade   DateTime?
  enviadoPorId   String
  enviadoPor     Usuario            @relation("DocumentoEnviadoPor", fields: [enviadoPorId], references: [id])
  excluidoEm     DateTime?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt

  @@index([condominioId, categoriaId])
  @@index([condominioId, dataValidade])
  @@index([fornecedorId])
  @@index([unidadeId])
  @@index([condominioId, competenciaAno, competenciaMes])
  @@map("documentos")
}

// Contratos com fornecedores/prestadores (Sprint 5) — o modelo já existia
// desde a Fase 1 ("estrutura pronta"), sem UI. Reaproveita o mesmo bucket
// e o mesmo padrão de upload construídos para Documentos no Sprint 4
// (arquivoUrl guarda a chave do objeto, não uma URL pública; download
// mediado por rota autenticada — ver /api/contratos/[id]/download).
// `dataFim` já existia e é a base do alerta de vencimento — não foi
// necessário nenhum campo novo de "validade" como em Documento.
model Contrato {
  id            String      @id @default(cuid())
  condominioId  String
  condominio    Condominio  @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  fornecedorId  String?
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  nome          String      @default("Contrato")
  tipo          String
  dataInicio    DateTime
  dataFim       DateTime?
  valor         Decimal?    @db.Decimal(12, 2)
  periodicidade String?
  arquivoUrl    String?
  arquivoNome   String?
  arquivoTipo   String?
  tamanhoBytes  Int?
  ativo         Boolean     @default(true)
  observacoes   String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  @@index([condominioId, ativo])
  @@index([condominioId, dataFim])
  @@map("contratos")
}

// ----------------------------------------------------------------------------
// ASSEMBLEIAS & ATAS
// ----------------------------------------------------------------------------

enum TipoAssembleia {
  ORDINARIA
  EXTRAORDINARIA
}

enum StatusAssembleia {
  AGENDADA
  REALIZADA
  CANCELADA
}

// Assembleias e atas (Sprint 7) — diferente de Documento/Contrato/
// MovimentoFundoReserva, este modelo não existia como "estrutura pronta"
// da Fase 1: é schema novo, escolhido entre as opções de novo módulo
// (manutenções, ocorrências, assembleias, comunicados, veículos/pets —
// seção 6 de EVOLUCAO-PLATAFORMA.md) por já ser um serviço explícito do
// escopo da Bem Viver ("suporte para realização de assembleias").
//
// Cobre o ciclo agendar → convocar → realizar → registrar ata. Reaproveita
// o mesmo bucket/padrão de upload de Documentos e Contratos (`arquivoUrl`
// guarda a chave do objeto, nunca uma URL pública; pastaBase="assembleias")
// — nenhuma decisão de infraestrutura nova. Votação digital foi
// conscientemente deixada de fora do escopo (o próprio pedido original já
// reconhecia isso): este módulo registra o evento e a ata, não conduz a
// assembleia em si.
//
// `status` é um enum de 3 estados (não um `ativo: Boolean` como em
// Contrato) porque há uma transição de negócio real a representar —
// agendada, realizada ou cancelada — e não apenas um par ligado/desligado.
// Todas as transições são reversíveis (ver `atualizarStatusAssembleia`),
// mantendo a mesma filosofia de reversibilidade (UX-1) usada em todo o
// sistema.
model Assembleia {
  id           String           @id @default(cuid())
  condominioId String
  condominio   Condominio       @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  tipo         TipoAssembleia   @default(ORDINARIA)
  dataHora     DateTime
  local        String?
  pauta        String
  status       StatusAssembleia @default(AGENDADA)
  arquivoUrl   String?
  arquivoNome  String?
  arquivoTipo  String?
  tamanhoBytes Int?
  observacoes  String?
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@index([condominioId, dataHora])
  @@index([condominioId, status])
  @@map("assembleias")
}

// ----------------------------------------------------------------------------
// AUDITORIA
// ----------------------------------------------------------------------------

enum AcaoAuditoria {
  CRIACAO
  ATUALIZACAO
  EXCLUSAO
  PUBLICACAO
  LOGIN
  LOGIN_FALHOU
}

model LogAuditoria {
  id          String        @id @default(cuid())
  usuarioId   String?
  usuario     Usuario?      @relation(fields: [usuarioId], references: [id])
  acao        AcaoAuditoria
  entidade    String
  entidadeId  String?
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  criadoEm    DateTime      @default(now())

  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}
